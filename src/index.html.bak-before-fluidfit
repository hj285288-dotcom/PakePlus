<script data-purpose="ui-gate">
/* Tailwind 用的是 Play CDN（浏览器端实时编译）：它要等编译完成（await postcss）之后，
   才把 <style> 插进 <head>。实测原逻辑：脚本 onload 触发、页面已经可见时，样式表还要 90~110ms 才生成，
   这段时间整页完全没有样式 —— 这就是"文字闪一下紫色、齿轮和铃铛图标闪一下"的原因。
   所以门闸不能挂在脚本 onload 上，必须等到"样式表已经真的生成"再放行。 */
(function () {
  var root = document.documentElement;
  var MARK = '7533917'; /* 唯一标记：把它当作类名塞进 DOM，会强制 CDN 拿"完整页面"再编译一次样式表 */
  var done = false, t0 = 0;

  function reveal() {
    if (done) return;
    done = true;
    var probe = document.getElementById('ui-gate-probe');
    if (probe && probe.parentNode) probe.parentNode.removeChild(probe);
    root.classList.add('ui-ready');
  }
  window.__revealUI = reveal;

  function has(needle) {
    var list = document.head ? document.head.getElementsByTagName('style') : [];
    for (var i = 0; i < list.length; i++) {
      var css = list[i].textContent || '';
      if (css.length > 3000 && css.indexOf(needle) !== -1) return true;
    }
    return false;
  }

  function start() {
    if (done) return;
    if (!document.body) { setTimeout(start, 12); return; }
    t0 = Date.now();
    var probe = document.createElement('i');
    probe.id = 'ui-gate-probe';
    probe.className = 'z-[' + MARK + ']';
    probe.setAttribute('aria-hidden', 'true');
    probe.style.cssText = 'position:absolute;left:-9999px;top:0;width:0;height:0;visibility:hidden;';
    document.body.appendChild(probe);
