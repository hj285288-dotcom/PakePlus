<script data-purpose="tauri-winstrip">
/* PakePlus 无边框窗口控制：仅在 Tauri 环境（window.__TAURI__ 存在）生效。
   给 <html> 加 .tauri → 顶部 16px 隐形条激活：
   · 按住条内空白处拖动窗口（startDragging）
   · 双击条内空白处切换最大化/还原（toggleMaximize）
   · 悬停顶部条时右上角淡入「最小化 / 关闭」按钮
   浏览器直接打开时什么都不做，UI 与原来完全一致。 */
(function () {
  function init() {
    if (!('__TAURI__' in window) || !window.__TAURI__) return;
    document.documentElement.classList.add('tauri');

    var win = null;
    try { win = window.__TAURI__.window.getCurrentWindow(); } catch (e) { win = null; }

    var strip = document.getElementById('win-strip');
    if (!strip) return;

    strip.querySelectorAll('.win-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (!win) return;
        var act = btn.getAttribute('data-act');
        try {
          if (act === 'min') win.minimize();
          else if (act === 'close') win.close();
        } catch (err) { /* 权限缺失时静默忽略 */ }
      });
    });

    strip.addEventListener('mousedown', function (e) {
      if (e.target.closest('.win-btn')) return;
      if (!win) return;
      try { win.startDragging(); } catch (err) { /* 忽略 */ }
    });
    strip.addEventListener('dblclick', function (e) {
      if (e.target.closest('.win-btn')) return;
      if (!win) return;
      try { win.toggleMaximize(); } catch (err) { /* 忽略 */ }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
