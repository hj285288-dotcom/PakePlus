      if (has(MARK)) { reveal(); return; }                                  /* 最可靠：样式表是按整页编译出来的 */
      if (Date.now() - t0 > 900 && has('.text-xs')) { reveal(); return; }    /* 退一步：样式表已生成 */
      if (Date.now() - t0 > 2500) { reveal(); return; }                      /* 兜底：绝不长时间白屏 */
      setTimeout(poll, 12);
    })();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
